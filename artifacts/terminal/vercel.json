{
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @workspace/terminal run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "env": {
    "VITE_API_URL": "https://memecointradingbot2-pk0b.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://memecointradingbot2-pk0b.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
